+export function LedgerIconDefs() {
+  return (
+    <svg
+      aria-hidden="true"
+      width="0"
+      height="0"
+      style={{ position: "absolute", overflow: "hidden" }}
+    >
+      <defs>
+        <symbol id="search-icon" viewBox="0 0 24 24">
+          <circle cx="10.8" cy="10.8" r="6.8" />
+          <path d="m16 16 5 5" />
+        </symbol>
+        <symbol id="chevron-icon" viewBox="0 0 24 24">
+          <path d="m6 9 6 6 6-6" />
+        </symbol>
+        <symbol id="close-icon" viewBox="0 0 24 24">
+          <path d="M6 6 18 18 M18 6 6 18" />
+        </symbol>
+        <symbol id="lock-icon" viewBox="0 0 24 24">
+          <rect x="5" y="10.5" width="14" height="10" rx="2" />
+          <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
+        </symbol>
+        <symbol id="empty-icon" viewBox="0 0 24 24">
+          <circle cx="12" cy="12" r="9" />
+          <path d="M12 7v5 M12 16h.01" />
+        </symbol>
+      </defs>
+    </svg>
+  );
+}
+
+export function Icon({
+  name,
+  className = "ico",
+}: {
+  name: string;
+  className?: string;
+}) {
+  return (
+    <svg className={className} aria-hidden="true">
+      <use href={`#${name}`} />
+    </svg>
+  );
+}
diff --git a/admin/src/features/ledger/ledger-api.ts b/admin/src/features/ledger/ledger-api.ts
new file mode 100644
index 0000000..35d8247
--- /dev/null
+++ b/admin/src/features/ledger/ledger-api.ts
@@ -0,0 +1,90 @@
+import { AdminApiError } from "../../lib/api";
+import { supabase } from "../../lib/supabase";
+
+export type ActivityUserSummary = {
+  id: string;
+  display_name: string;
+  handle: string | null;
+  email: string | null;
+  timezone: string | null;
+  created_at: string;
+  telemetry_enabled?: boolean | null;
+  first_seen_at?: string | null;
+  last_seen_at?: string | null;
+  last_event_at?: string | null;
+  last_event_label?: string | null;
+  event_count: number;
+};
+
+export type ActivityUsersPayload = {
+  period_days: number;
+  total_matching_users: number;
+  users: ActivityUserSummary[];
+};
+
+export type ActivityTimelineRow = {
+  id: string;
+  occurred_at: string;
+  source_table: string;
+  event_name: string;
+  canonical_event: string;
+  category: string;
+  label: string;
+  basis: string;
+  safe_fields?: Record<string, unknown> | null;
+};
+
+export type ActivityUserDetailPayload = {
+  period_days: number;
+  profile: {
+    id: string;
+    display_name: string;
+    handle: string | null;
+    email: string | null;
+    timezone: string | null;
+    created_at: string;
+  };
+  timeline: ActivityTimelineRow[];
+};
+
+async function callRpc<T>(
+  name: string,
+  args: Record<string, unknown>,
+): Promise<T> {
+  if (!supabase) {
+    throw new AdminApiError("Supabase admin configuration is missing.", 500);
+  }
+  const { data, error } = await supabase.rpc(name, args);
+  if (error) {
+    const status =
+      error.code === "42501"
+        ? 403
+        : error.message.toLowerCase().includes("jwt")
+          ? 401
+          : 400;
+    throw new AdminApiError(error.message, status, error.code);
+  }
+  return data as T;
+}
+
+export async function fetchActivityUsers(
+  days: number,
+  limit = 250,
+  query?: string | null,
+): Promise<ActivityUsersPayload> {
+  return callRpc<ActivityUsersPayload>("admin_activity_users", {
+    p_days: days,
+    p_limit: limit,
+    p_query: query ?? null,
+  });
+}
+
+export async function fetchActivityUserDetail(
+  userId: string,
+  days: number,
+): Promise<ActivityUserDetailPayload> {
+  return callRpc<ActivityUserDetailPayload>("admin_activity_user_detail", {
+    p_target_user_id: userId,
+    p_days: days,
+  });
+}
