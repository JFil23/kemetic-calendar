    {
      "after": "/* Contact uses the same view and validation, with acknowledged server delivery. */\nconst main=$('main:not(#contact)'),support=$('#contact'),form=$('#support-form'),result=$('#support-result');\nlet previousSupport=false;\nfunction route(){\n  const open=location.hash==='#contact';main.hidden=open;support.hidden=!open;\n  $$('.contact-link').forEach(a=>open?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current'));\n  if(open){$('#brand-film')?.pause();window.scrollTo(0,0);requestAnimationFrame(()=>$('#support-title').focus({preventScroll:true}));}\n  else if(previousSupport){const destination=$(location.hash||'#top');requestAnimationFrame(()=>destination?.scrollIntoView({behavior:'instant',block:'start'}));}\n  previousSupport=open;\n}\nwindow.addEventListener('hashchange',route);route();\n$('.skip')?.addEventListener('click',e=>{e.preventDefault();const target=support.hidden?main:$('#support-title');target.tabIndex=-1;target.focus();target.scrollIntoView({block:'start'});});\nconst submitButton=$('#support-submit');let submitting=false;\nfunction showResult(text,status){result.hidden=false;result.dataset.status=status;result.replaceChildren(document.createTextNode(text));}\nfunction validateMessage(){const field=$('#support-message');field.setCustomValidity(field.value.trim()?'':'Please tell us a little about what you need help with.');return form.reportValidity();}\n$('#support-message').addEventListener('input',()=>$('#support-message').setCustomValidity(''));\nform.addEventListener('submit',async e=>{\n  e.preventDefault();if(submitting||!validateMessage())return;\n  const draft=Object.fromEntries(new FormData(form));\n  Object.keys(draft).forEach(key=>{draft[key]=String(draft[key]).trim();});\n  submitting=true;result.hidden=true;form.setAttribute('aria-busy','true');\n  const controls=[...form.elements];controls.forEach(control=>control.disabled=true);\n  submitButton.firstChild.textContent='Sending\u2026 ';\n  const controller